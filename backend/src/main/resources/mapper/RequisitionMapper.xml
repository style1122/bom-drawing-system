<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bom.mapper.RequisitionMapper">

    <resultMap id="requisitionMap" type="com.bom.entity.Requisition">
        <id property="id" column="id"/>
        <result property="requisitionNo" column="requisition_no"/>
        <result property="requisitionDate" column="requisition_date"/>
        <result property="requester" column="requester"/>
        <result property="department" column="department"/>
        <result property="remark" column="remark"/>
        <result property="erpSyncTime" column="erp_sync_time"/>
        <result property="createdAt" column="created_at"/>
        <result property="itemCount" column="item_count"/>
    </resultMap>

    <resultMap id="requisitionItemMap" type="com.bom.entity.RequisitionItem">
        <id property="id" column="id"/>
        <result property="requisitionId" column="requisition_id"/>
        <result property="materialCode" column="material_code"/>
        <result property="materialName" column="material_name"/>
        <result property="specification" column="specification"/>
        <result property="quantity" column="quantity"/>
        <result property="unit" column="unit"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="materialId" column="material_id"/>
        <result property="hasDrawing" column="has_drawing"/>
        <result property="drawingId" column="drawing_id"/>
        <result property="drawingName" column="drawing_name"/>
        <result property="drawingCount" column="drawing_count"/>
    </resultMap>

    <!-- 公共查询片段：采购订单 + 明细数量 -->
    <sql id="requisitionWithCount">
        SELECT r.*,
               ISNULL(ic.item_count, 0) AS item_count
        FROM requisition r
        LEFT JOIN (
            SELECT requisition_id, COUNT(*) AS item_count
            FROM requisition_item
            GROUP BY requisition_id
        ) ic ON r.id = ic.requisition_id
    </sql>

    <!-- 公共搜索 WHERE 片段 -->
    <sql id="searchCondition">
        WHERE (r.requisition_no LIKE '%' + #{keyword} + '%'
           OR r.requester LIKE '%' + #{keyword} + '%'
           OR r.department LIKE '%' + #{keyword} + '%')
        <if test="purchaserName != null and purchaserName != ''">
           AND r.requester = #{purchaserName}
        </if>
    </sql>

    <!-- 分页查询全部 -->
    <select id="findAllPaged" resultMap="requisitionMap">
        <include refid="requisitionWithCount"/>
        <where>
            <if test="purchaserName != null and purchaserName != ''">
                r.requester = #{purchaserName}
            </if>
        </where>
        ORDER BY r.requisition_date DESC, r.id DESC
        OFFSET #{offset} ROWS
        FETCH NEXT #{size} ROWS ONLY
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM requisition r
        <where>
            <if test="purchaserName != null and purchaserName != ''">
                r.requester = #{purchaserName}
            </if>
        </where>
    </select>

    <!-- 分页搜索 -->
    <select id="searchPaged" resultMap="requisitionMap">
        <include refid="requisitionWithCount"/>
        <include refid="searchCondition"/>
        ORDER BY r.requisition_date DESC, r.id DESC
        OFFSET #{offset} ROWS
        FETCH NEXT #{size} ROWS ONLY
    </select>

    <select id="countSearch" resultType="long">
        SELECT COUNT(*) FROM requisition r
        <include refid="searchCondition"/>
    </select>

    <!-- 查询单个采购订单（基本信息） -->
    <select id="findById" resultMap="requisitionMap">
        <include refid="requisitionWithCount"/>
        WHERE r.id = #{id}
    </select>

    <!--
        查询采购订单明细，关联 material 和 drawing 表：
        - 通过 material_code 关联 material 表获取 material_id
        - 通过 material_id 关联 drawing 表，获取最新 PDF 图纸信息
        - 使用 OUTER APPLY 获取每个物料最新的一条 PDF 图纸
    -->
    <select id="findItemsByRequisitionId" resultMap="requisitionItemMap">
        SELECT ri.*,
               m.id AS material_id,
               CASE WHEN dc.draw_count > 0 THEN 1 ELSE 0 END AS has_drawing,
               ISNULL(dc.draw_count, 0) AS drawing_count,
               latest_pdf.id AS drawing_id,
               latest_pdf.drawing_name AS drawing_name
        FROM requisition_item ri
        LEFT JOIN material m ON ri.material_code = m.material_code
        LEFT JOIN (
            SELECT material_id, COUNT(*) AS draw_count
            FROM drawing
            WHERE LOWER(file_format) = 'pdf'
            GROUP BY material_id
        ) dc ON m.id = dc.material_id
        OUTER APPLY (
            SELECT TOP 1 d.id, d.drawing_name
            FROM drawing d
            WHERE d.material_id = m.id
              AND LOWER(d.file_format) = 'pdf'
            ORDER BY d.created_at DESC
        ) latest_pdf
        WHERE ri.requisition_id = #{requisitionId}
        ORDER BY ri.id
    </select>

</mapper>
