<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bom.mapper.SysUserMapper">

    <resultMap id="sysUserMap" type="com.bom.entity.SysUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="displayName" column="display_name"/>
        <result property="role" column="role"/>
        <result property="status" column="status"/>
        <result property="rejectReason" column="reject_reason"/>
        <result property="reviewedBy" column="reviewed_by"/>
        <result property="reviewedAt" column="reviewed_at"/>
        <result property="loginFailures" column="login_failures"/>
        <result property="lockedUntil" column="locked_until"/>
        <result property="lastLoginAt" column="last_login_at"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByUsername" resultMap="sysUserMap">
        SELECT * FROM sys_user WHERE username = #{username}
    </select>

    <select id="findById" resultMap="sysUserMap">
        SELECT * FROM sys_user WHERE id = #{id}
    </select>

    <select id="findPendingUsers" resultMap="sysUserMap">
        SELECT * FROM sys_user WHERE status = 'PENDING' ORDER BY created_at ASC
    </select>

    <insert id="insert" parameterType="com.bom.entity.SysUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password_hash, display_name, role, status, login_failures, created_at)
        VALUES (#{username}, #{passwordHash}, #{displayName}, #{role}, #{status}, #{loginFailures}, #{createdAt})
    </insert>

    <update id="updateStatus">
        UPDATE sys_user
        SET status = #{status},
            reject_reason = #{rejectReason},
            reviewed_by = #{reviewedBy},
            reviewed_at = GETDATE()
        WHERE id = #{id}
    </update>

    <select id="findAll" resultMap="sysUserMap">
        SELECT * FROM sys_user ORDER BY created_at DESC
    </select>

    <select id="findApprovedUsers" resultMap="sysUserMap">
        SELECT * FROM sys_user WHERE status = 'ACTIVE' ORDER BY created_at DESC
    </select>

    <update id="update" parameterType="com.bom.entity.SysUser">
        UPDATE sys_user
        <set>
            <if test="passwordHash != null">password_hash = #{passwordHash},</if>
            <if test="displayName != null">display_name = #{displayName},</if>
            <if test="role != null">role = #{role},</if>
            <if test="status != null">status = #{status},</if>
            <if test="loginFailures != null">login_failures = #{loginFailures},</if>
            <if test="lockedUntil != null">locked_until = #{lockedUntil},</if>
            <if test="lastLoginAt != null">last_login_at = #{lastLoginAt},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
